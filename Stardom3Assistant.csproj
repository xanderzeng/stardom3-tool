    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Stardom3Assistant</AssemblyName>
    <RootNamespace>Stardom3Assistant</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="research\**\*.cs" />
