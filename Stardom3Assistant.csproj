<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Stardom3Assistant</AssemblyName>
    <RootNamespace>Stardom3Assistant</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="research\**\*.cs" />
    <EmbeddedResource Remove="research\**\*" />
    <None Remove="research\**\*" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Data\flysky-events.json" />
  </ItemGroup>
</Project>
